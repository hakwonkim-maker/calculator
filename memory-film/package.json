{
  "name": "memoria-film-studio",
  "version": "1.6.0",
  "description": "사진 폴더로 고품질 기념 영상을 만드는 PC용 프로그램",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "start": "npm run build && electron .",
    "electron:dev": "electron . --dev",
    "dist:win": "node scripts/fetch-music.cjs && npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "test:render": "node tests/render-test.mjs",
    "fixtures": "bash tests/make-fixtures.sh",
    "test:ui": "node tests/ui-test.mjs",
    "test:e2e": "node tests/e2e-electron.mjs",
    "music": "node scripts/fetch-music.cjs",
    "test:unit": "node tests/photodate-test.cjs && node tests/select-test.mjs && node tests/beats-test.mjs && node tests/enhance-test.mjs && node tests/magic-test.mjs"
  },
  "author": "MEMORIA",
  "license": "UNLICENSED",
  "devDependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/gilda-display": "^5.3.0",
    "@fontsource/gowun-batang": "^5.3.0",
    "@fontsource/gowun-dodum": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/jua": "^5.3.0",
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "@fontsource/playfair-display": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "heic-decode": "^2.1.0",
    "image-size": "^2.0.4"
  },
  "productName": "MEMORIA 기념영상 스튜디오",
  "type": "module",
  "build": {
    "appId": "com.memoria.filmstudio",
    "productName": "MEMORIA Film Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist-renderer/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "MEMORIA-Film-Studio-Setup-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MEMORIA 기념영상 스튜디오"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "icon": "build/icon.png"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "music-library",
        "to": "music-library",
        "filter": [
          "**/*"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "memoria",
        "name": "MEMORIA 프로젝트",
        "description": "MEMORIA 기념영상 프로젝트",
        "role": "Editor"
      }
    ]
  }
}
